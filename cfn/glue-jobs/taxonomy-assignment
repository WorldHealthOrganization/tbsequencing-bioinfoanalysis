import sys
# import boto3
# import os
# import json

from awsglue.transforms import ApplyMapping, SelectFields, Join, Map, ResolveChoice
from awsglue.utils import getResolvedOptions
from pyspark.context import SparkContext
from awsglue.context import GlueContext
from awsglue.job import Job

## @params: [JOB_NAME]
args = getResolvedOptions(
    sys.argv,
    ['JOB_NAME', "glue_db_name", "postgres_db_name", "rds_port", "rds_host"]
)

sc = SparkContext()
glueContext = GlueContext(sc)
spark = glueContext.spark_session
job = Job(glueContext)
job.init(args['JOB_NAME'], args)

dbname = args["postgres_db_name"]
glue_dbname = args["glue_db_name"]

# Adding extra safeguard
# Filter sample ids that have been correctly processed
# bioanalysis_status = 'Uploaded to S3'
# No bookmark on that data source because we need to
# read the full table at each run

sample = (
    glueContext.create_dynamic_frame.from_catalog(
        database=glue_dbname,
        table_name=dbname + "_public_submission_sample"
    )
    .filter(
        f=lambda x: x["bioanalysis_status"]=="Uploaded to S3"
    )
    .rename_field(
        "`id`",
        "sampleid"
    )
)

print('--- "public_submission_sample"  ---')
print('--- "Samples Uploaded to S3 and ready for insertion"  ---')
print(sample.count())


datasource0 = (
    glueContext.create_dynamic_frame.from_catalog(
        database = args["glue_db_name"],
        table_name = "taxonomy_assignment",
        transformation_ctx = "datasource0"
    )
)


join1 = Join.apply(
    frame1 = datasource0,
    frame2 = sample,
    keys1 = "sampleid",
    keys2 = "sampleid",
    transformation_ctx="join1"
)


applymapping2 = (
    ApplyMapping.apply(
        frame = join1,
        mappings = [("sampleid", "long", "sample_id", "int"), ("ncbitaxonid", "long", "ncbi_taxon_id", "int"), ("value", "double", "value", "double")],
        transformation_ctx = "applymapping2"
    )
)

selectfields3 = SelectFields.apply(
    frame = applymapping2,
    paths = ["value", "ncbi_taxon_id", "sample_id"],
    transformation_ctx = "selectfields3"
)

def correct_taxonid(dynamicRecord):
    if dynamicRecord["ncbi_taxon_id"]==1570328:
        dynamicRecord["ncbi_taxon_id"]=1795
    return dynamicRecord

map4 = (
    Map.apply(
        frame = selectfields3,
        f = correct_taxonid,
        transformation_ctx = "map4"
    )
    .filter(f=lambda x: x["ncbi_taxon_id"]!=0)
)

resolvechoice5 = ResolveChoice.apply(
    frame = map4,
    choice = "MATCH_CATALOG",
    database = args["glue_db_name"],
    table_name = f"{args['postgres_db_name']}_public_submission_taxonomystats", transformation_ctx = "resolvechoice5"
)

resolvechoice6 = ResolveChoice.apply(
    frame = resolvechoice5,
    choice = "make_cols",
    transformation_ctx = "resolvechoice6"
)

datasink7 = glueContext.write_dynamic_frame.from_catalog(
    frame = resolvechoice6,
    database = args["glue_db_name"],
    table_name = f"{args['postgres_db_name']}_public_submission_taxonomystats",
    transformation_ctx = "datasink7"
)

job.commit()